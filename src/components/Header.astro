---
import { empresa } from '../data/empresa.js';

const currentPath = Astro.url.pathname;
---

<header class="cabecalho">
	<div class="faixa-topo"></div>
	<div class="container cabecalho-container">
		<a href="/" class="logo-link">
			<img 
				src="/images/logo.png" 
				alt={`Logotipo da ${empresa.nome}`} 
				class="logo-img" 
			/>
		</a>

		<nav class="navegacao">
			<ul>
				<li><a href="/" class:list={[{ ativo: currentPath === '/' }]}>Início</a></li>
				<li><a href="/sobre" class:list={[{ ativo: currentPath.startsWith('/sobre') }]}>Sobre</a></li>
				<li><a href="/equipe" class:list={[{ ativo: currentPath.startsWith('/equipe') }]}>Equipe</a></li>
				<li><a href="/contato" class:list={[{ ativo: currentPath.startsWith('/contato') }]}>Contato</a></li>
			</ul>
		</nav>
	</div>
</header>

<style>
	.faixa-topo {
		height: 6px;
		background: var(--degrade-marca);
	}

		.cabecalho {
		position: sticky;
		top: 0;
		z-index: 10;
		background-color: var(--cor-destaque);
		border-bottom: 2px solid var(--cor-primaria);
		box-shadow: 0 4px 14px rgba(0, 0, 0, 0.4);
		padding-bottom: 1rem;
	}

	.cabecalho-container {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 1.5rem;
		padding-top: 1.5rem;
	}

	.logo-img {
		height: 54px;
		width: auto;
		display: block;
	}

	.navegacao ul {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 1.5rem;
	}

	.navegacao a {
		font-weight: 700;
		font-size: 0.95rem;
		color: var(--cor-primaria);
		padding: 0.5rem 0;
		border-bottom: 2px solid transparent;
	}

	.navegacao a:hover,
	.navegacao a.ativo {
		color: var(--cor-secundaria);
		border-bottom-color: var(--cor-secundaria);
		text-decoration: none;
	}
</style>