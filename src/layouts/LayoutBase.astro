---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Constelacao from '../components/Constelacao.astro';
import GradeTech from '../components/GradeTech.astro';
import { empresa } from '../data/empresa.js';

const { titulo, descricao, constelacao = false } = Astro.props;
---

<html lang="pt-BR">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={descricao} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800&display=swap" rel="stylesheet" />
		<title>{titulo} | {empresa.nome}</title>
		<title>{titulo} | {empresa.nome}</title>
	</head>
	<body>
		{constelacao ? <Constelacao /> : <GradeTech />}
		<Header />
		<main>
			<slot />
		</main>
		<Footer />
	</body>
</html>